# Токен Discord-бота (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Токен Telegram-бота (@BotFather)
TELEGRAM_TOKEN=

# Путь к файлу SQLite (в Docker маппится в ./data)
DB_PATH=data/bot.db

# Необязательно: включённые модули через запятую (по умолчанию все).
# roles — верификация и именные роли.
ENABLED_MODULES=roles

# Необязательно: время на верификацию и интервал напоминаний, сек.
VERIFICATION_TIMEOUT=600
REMINDER_INTERVAL=60

# Необязательно: срок жизни кода /connect, сек.
CONNECT_CODE_TTL=600

# Необязательно: ID сервера для мгновенной синхронизации slash-команд при разработке
# (глобальная синхронизация может занимать до часа)
TEST_GUILD_ID=
